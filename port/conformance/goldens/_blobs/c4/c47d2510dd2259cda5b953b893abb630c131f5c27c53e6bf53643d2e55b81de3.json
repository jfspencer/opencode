: \"active\" | \"paused\" | \"done\",\n  nextDueAt?: string,\n  endsAt?: string,\n  remainingRuns?: number,\n  runCount: number,\n  lastFiredAt?: string,\n  lastOutcome?: \"fired\" | \"late\" | \"checked\" | \"expired\" | \"skipped\" | \"disabled\" | \"failed\",\n  lastOutput?: string,\n}> // Pause a schedule. It keeps its settings and does not fire until resumed.\n  - tools.opencode.schedule_resume({\n  /** Schedule id from schedule_list. @pattern ^sch_ */\n  id: string,\n}): Promise<{\n  /** @pattern ^sch_ */\n  id: string,\n  name?: string,\n  when: {\n      type: \"in\",\n      /** A duration such as \"90 seconds\", \"5 minutes\" or \"2 hours\". */\n      in: string,\n      tz?: string,\n    } | {\n      type: \"at\",\n      at: string,\n      tz?: string,\n    } | {\n      type: \"every\",\n      /** A duration such as \"90 seconds\", \"5 minutes\" or \"2 hours\". */\n      every: string,\n      tz?: string,\n    } | {\n      type: \"cron\",\n      cron: string,\n      tz?: string,\n    },\n  tz: string,\n  if?: {\n      type: \"shell\",\n      run: string,\n      is?: string,\n      matches?: string,\n      changes?: boolean,\n    } | {\n      type: \"code\",\n      code: string,\n    },\n  until?: {\n      type: \"shell\",\n      run: string,\n      is?: string,\n      matches?: string,\n      changes?: boolean,\n    } | {\n      type: \"code\",\n      code: string,\n    },\n  prompt: string,\n  status: \"active\" | \"paused\" | \"done\",\n  nextDueAt?: string,\n  endsAt?: string,\n  remainingRuns?: number,\n  runCount: number,\n  lastFiredAt?: string,\n  lastOutcome?: \"fired\" | \"late\" | \"checked\" | \"expired\" | \"skipped\" | \"disabled\" | \"failed\",\n  lastOutput?: string,\n}> // Resume a paused schedule. A one-shot that fell due while paused fires once now; a repeating one resumes at its next s...\n  - tools.opencode.session_move({\n  /** Omit to move the current session. @pattern ^ses */\n  sessionID?: string,\n  /** Destination directory, relativ