From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:08:20 -0700
Subject: [PATCH] D403 cli: an unknown command or missing directory fails with
 a clean error


diff --git a/packages/cli/src/commands/handlers/default.ts b/packages/cli/src/commands/handlers/default.ts
index b0a6d500e5..fabc8f94f3 100644
--- a/packages/cli/src/commands/handlers/default.ts
+++ b/packages/cli/src/commands/handlers/default.ts
@@ -5,7 +5,6 @@ import { Commands } from "../commands"
 import { Runtime } from "../../framework/runtime"
 import { Config } from "../../config"
 import { Context, Effect, FileSystem, Option, Queue, Schedule, Semaphore } from "effect"
-import { CliError } from "effect/cli"
 import { ServerConnection } from "../../services/server-connection"
 import { Updater } from "../../services/updater"
 import { UpdatePreflight } from "../../services/update-preflight"
@@ -27,12 +26,12 @@ export default Runtime.handler(Commands, (input) =>
         Effect.map((info) => info.type === "Directory"),
         Effect.orElseSucceed(() => false),
       )
-      // `opencode login` reads as a mistyped command more often than a directory, so answer with help, not ENOENT.
-      if (!isDirectory)
-        return yield* new CliError.ShowHelp({
-          commandPath: [Commands.name],
-          errors: [new CliError.ValidationError({ message: `No directory or command named "${requestedDirectory}"` })],
-        })
+      // An unknown command word arrives here too, as the optional directory argument.
+      if (!isDirectory) {
+        process.stderr.write(`Unknown command or directory: ${requestedDirectory}\n`)
+        process.exitCode = 1
+        return
+      }
       process.chdir(requestedDirectory)
     }
     const preflight = UpdatePreflight.make()
