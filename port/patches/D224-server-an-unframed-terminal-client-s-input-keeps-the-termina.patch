diff --git a/packages/server/test/persistent-pty.test.ts b/packages/server/test/persistent-pty.test.ts
index 2be137bb61..0f4e117825 100644
--- a/packages/server/test/persistent-pty.test.ts
+++ b/packages/server/test/persistent-pty.test.ts
@@ -208,6 +208,81 @@ smoke(
   20_000,
 )
 
+smoke(
+  "an unframed client's input keeps the terminal's current size",
+  () =>
+    Effect.gen(function* () {
+      const fixture = yield* testDirectory()
+      const server = yield* ServerProcess.start<never, never>({
+        hostname: "127.0.0.1",
+        port: 0,
+        password: "secret",
+        app: { version: "test-version" },
+        database: { path: fixture.database },
+        pty: { root: fixture.directory },
+        fs: { filewatcher: false },
+      })
+      const base = HttpServer.formatAddress(server.address)
+      const client = OpenCode.make({ baseUrl: base, headers: { authorization: `Basic ${btoa("opencode:secret")}` } })
+      const terminal = yield* Effect.promise(() =>
+        client.experimental.persistentPty.create({
+          sessionID: Session.ID.make("ses_persistent_pty_unframed"),
+          command: "/bin/sh",
+          args: ["-c", "stty -echo; printf ready; while read line; do stty size; done"],
+          cwd: fixture.root,
+          title: "unframed",
+          env: {},
+          size: { cols: 40, rows: 10 },
+        }),
+      )
+      yield* waitForText(base, terminal.id, "ready")
+      yield* Effect.promise(async () => {
+        const ticket = await Effect.runPromise(
+          request(base, "POST", `/api/experimental/persistent-pty/${terminal.id}/connect-token`, undefined, {
+            "x-opencode-ticket": "1",
+          }),
+        )
+        if (!isRecord(ticket.data) || typeof ticket.data.ticket !== "string") throw new Error("Invalid connect ticket")
+        const url = new URL(`/api/experimental/persistent-pty/${terminal.id}/connect`, base)
+        url.protocol = "ws:"
+        url.searchParams.set("ticket", ticket.data.ticket)
+        url.searchParams.set("attachment_id", "unframed")
+        const socket = new WebSocket(url)
+        socket.binaryType = "arraybuffer"
+        const state = { output: "", closed: false, ready: false, resized: false }
+        socket.addEventListener("message", (event) => {
+          if (event.data instanceof ArrayBuffer) state.output += new TextDecoder().decode(event.data)
+          else {
+            const type = JSON.parse(String(event.data)).type
+            if (type === "replay_complete") state.ready = true
+            if (type === "resized") state.resized = true
+          }
+        })
+        socket.addEventListener("close", () => (state.closed = true))
+        try {
+          for (let attempt = 0; attempt < 100 && !state.ready; attempt++) await Bun.sleep(20)
+          expect(state.ready).toBeTrue()
+          await client.experimental.persistentPty.update({
+            ptyID: terminal.id,
+            attachmentID: "unframed",
+            size: { cols: 50, rows: 12 },
+          })
+          for (let attempt = 0; attempt < 100 && !state.resized; attempt++) await Bun.sleep(20)
+          expect(state.resized).toBeTrue()
+          socket.send("size\n")
+          await waitForSocketOutput([state], "12 50")
+        } finally {
+          socket.close()
+        }
+      })
+      expect(yield* Effect.promise(() => client.experimental.persistentPty.get({ ptyID: terminal.id }))).toMatchObject({
+        size: { cols: 50, rows: 12 },
+      })
+      yield* Effect.promise(() => client.experimental.persistentPty.shutdown())
+    }),
+  20_000,
+)
+
