From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:21:08 -0700
Subject: [PATCH] D509 code mode: Object.prototype.toString names Math, JSON
 and console


diff --git a/packages/codemode/test/stdlib.test.ts b/packages/codemode/test/stdlib.test.ts
index 01030049ce..0fc5c585dd 100644
--- a/packages/codemode/test/stdlib.test.ts
+++ b/packages/codemode/test/stdlib.test.ts
@@ -59,3 +59,20 @@ describe("well-known symbols", () => {
     ])
   })
 })
+
+describe("Object.prototype.toString of built-in namespaces", () => {
+  test("names Math, JSON, and console, which stay plain data in diagnostics", async () => {
+    expect(
+      await value(`
+      const tag = (v) => Object.prototype.toString.call(v)
+      return [tag(Math), tag(JSON), tag(console), String(Math), await Promise.try(JSON).catch((e) => e.message)]
+    `),
+    ).toEqual([
+      "[object Math]",
+      "[object JSON]",
+      "[object console]",
+      "[object Math]",
+      "Promise.try expects a function, received a data object.",
+    ])
+  })
+})
