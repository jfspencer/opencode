index 1e0de68fab..207abf53cd 100644
--- a/packages/codemode/src/interpreter/objects.ts
+++ b/packages/codemode/src/interpreter/objects.ts
@@ -172,6 +172,19 @@ export class Fn extends Callable {
   }
 }
 
+/** A built-in namespace object (`Math`, `JSON`, `console`): plain data that `Object.prototype.toString` names. */
+export class NamespaceObj extends Obj {
+  constructor(
+    proto: Obj,
+    override readonly tag: string,
+  ) {
+    super(proto)
+  }
+  override get describe() {
+    return "a data object"
+  }
+}
+
 /** The strict `arguments` object: an ordinary object with indexed own properties and a hidden `length`. */
 export class Arguments extends Obj {
   override readonly tag = "Arguments"
