diff --git a/packages/codemode/src/stdlib/console.ts b/packages/codemode/src/stdlib/console.ts
index f2cb8de3aa..8916417611 100644
--- a/packages/codemode/src/stdlib/console.ts
+++ b/packages/codemode/src/stdlib/console.ts
@@ -1,5 +1,5 @@
 import { type Method, methods } from "../interpreter/native.js"
-import { entries, get, Arr, Obj, type Value } from "../interpreter/objects.js"
+import { coerceToString, entries, get, Arr, Obj, type Value } from "../interpreter/objects.js"
 import { ToolReference } from "../tool-runtime.js"
 import { containsOpaqueReference } from "../interpreter/references.js"
 import type { Interpreter } from "../interpreter/interpreter.js"
@@ -33,7 +33,27 @@ const formatConsoleMessage = (name: string, args: Array<Value>): string => {
   if (name === "dir") return args.length === 0 ? "undefined" : formatValue(args[0])
   if (name === "table") return formatConsoleTable(args[0], args[1])
   const prefix = name === "warn" ? "[warn] " : name === "error" ? "[error] " : name === "debug" ? "[debug] " : ""
-  return `${prefix}${args.map((arg) => formatValue(arg)).join(" ")}`
+  return `${prefix}${formatArguments(args).join(" ")}`
+}
+
+// A first string argument with more after it takes them in its format specifiers, as the console does in JS: %s, %o,
+// and %O show the value, %d and %i parse an integer, %f a float, %c takes a style and shows nothing, and %% is a %.
+// A specifier left without an argument stays as written; arguments left over follow, separated by spaces.
+const formatArguments = (args: Array<Value>): Array<string> => {
+  const first = args[0]
+  if (typeof first !== "string" || args.length < 2) return args.map((arg) => formatValue(arg))
+  let next = 1
+  const text = first.replace(/%([sdifoOc%])/g, (specifier, kind: string) => {
+    if (kind === "%") return "%"
+    if (next >= args.length) return specifier
+    const arg = args[next++]
+    if (kind === "c") return ""
+    if (kind === "d" || kind === "i")
+      return formatValue(typeof arg === "symbol" ? NaN : parseInt(coerceToString(arg), 10))
+    if (kind === "f") return formatValue(typeof arg === "symbol" ? NaN : parseFloat(coerceToString(arg)))
+    return formatValue(arg)
+  })
+  return [text, ...args.slice(next).map((arg) => formatValue(arg))]
 }
 
 /** One value as `console.log` shows it. */
