Subject: [PATCH] D506 code mode: console.log applies format specifiers


diff --git a/packages/codemode/test/codemode.test.ts b/packages/codemode/test/codemode.test.ts
index ebfb59e692..1ca48b0d9e 100644
--- a/packages/codemode/test/codemode.test.ts
+++ b/packages/codemode/test/codemode.test.ts
@@ -465,6 +465,28 @@ describe("CodeMode console capture", () => {
     expect(result.logs).toStrictEqual(["NaN", "Infinity -Infinity", '{"ratio":NaN,"bounds":[Infinity]}'])
   })
 
+  test("a first string argument takes the arguments after it in its format specifiers", async () => {
+    const result = await Effect.runPromise(
+      CodeMode.execute({
+        code: `
+        console.log("%s has %d items (%i%%)", "cart", 3.7, "42", "extra")
+        console.warn("%o then %c%f", { a: [1] }, "color: red", "2.5px")
+        console.log("%s and %s", "only")
+        console.log("100%%")
+        return null
+      `,
+      }),
+    )
+
+    expect(result.ok).toBe(true)
+    expect(result.logs).toStrictEqual([
+      "cart has 3 items (42%) extra",
+      '[warn] {"a":[1]} then 2.5',
+      "only and %s",
+      "100%%",
+    ])
+  })
+
