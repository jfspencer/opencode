From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:07:05 -0700
Subject: [PATCH] D303 tui: --agent and --model apply once agents and models
 load


diff --git a/packages/tui/src/app.tsx b/packages/tui/src/app.tsx
index 4f623b03a7..6288be631a 100644
--- a/packages/tui/src/app.tsx
+++ b/packages/tui/src/app.tsx
@@ -26,6 +26,7 @@ import { RouteProvider, useRoute } from "./context/route"
 import {
   Switch,
   Match,
+  createComputed,
   createEffect,
   createMemo,
   ErrorBoundary,
@@ -679,7 +680,12 @@ function App() {
 
   const args = useArgs()
   const startupPrompt = args.prompt ? { text: args.prompt, files: [], agents: [], pasted: [] } : undefined
-  onMount(() => {
+  // --agent and --model name entries of the location's agents and models, which load after mount. A computed applies
+  // them before effects read the selection (Home submitting --prompt).
+  let selected = false
+  createComputed(() => {
+    if (selected || !local.agent.ready || !local.model.ready || !local.model.catalogReady) return
+    selected = true
     batch(() => {
       if (args.agent) local.agent.set(args.agent)
       if (args.model) {
@@ -692,15 +698,17 @@ function App() {
           })
         local.model.set({ providerID, modelID }, { recent: true })
       }
-      if (args.sessionID && !args.fork) {
-        route.navigate({
-          type: "session",
-          sessionID: args.sessionID,
-          prompt: startupPrompt,
-        })
-      }
     })
   })
+  onMount(() => {
+    if (args.sessionID && !args.fork) {
+      route.navigate({
+        type: "session",
+        sessionID: args.sessionID,
+        prompt: startupPrompt,
+      })
+    }
+  })
 
   let continued = false
   createEffect(() => {
diff --git a/packages/tui/src/context/local.tsx b/packages/tui/src/context/local.tsx
index d3304eb339..c652c93b91 100644
--- a/packages/tui/src/context/local.tsx
+++ b/packages/tui/src/context/local.tsx
@@ -86,6 +86,9 @@ export const { use: useLocal, provider: LocalProvider } = createSimpleContext({
         list() {
           return agents()
         },
+        get ready() {
+          return data.location.agent.list(location.ref) !== undefined
+        },
         current() {
           const draft = route.data.type === "session" ? agentStore.draftBySession[route.data.sessionID] : undefined
           const selected =
