From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sat, 7 Nov 2026 13:38:32 -0700
Subject: [PATCH] D101 permissions: "always" on a wrapped command approves only
 that command
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream: approving a wrapped command with "always" saved the wrapper alone: `sudo rm -rf /var/cache` saved `sudo *`, which then allowed every sudo command (same for env, xargs, nohup, exec, command, builtin, time, coproc and shells). Commands the scanner cannot identify saved a prefix that approved everything they can run: `sh -c '…'` saved `sh *`, `eval "…"` saved `eval *`, `$(which git) status` saved `$(which git) *`, `sudo -u root git status` saved `sudo *`.
Fixed: a wrapper's saved prefix extends to the wrapped command's prefix (`sudo rm *`, `env FOO=1 npm test *`, `timeout 10 git push *`). When only the shell can tell what runs (a dynamic command name, eval, or a wrapper option before the wrapped command), the command is saved exactly as approved.
Scenarios: permissions.test.ts "always on a wrapped command approves only the wrapped command" (new); shell-classify.test.ts wrappers, directory changes, assignments and declarations, substitutions and expansions, lists and pipelines (recorded save patterns)
Upstream tests: test/shell-parse.test.ts (wrapped cd prefixes updated, two new tests), test/shell-parse-compatibility.test.ts and test/shell-parse-syntax.test.ts (asserted the wrapper-only patterns)

diff --git a/packages/core/src/shell/parse.ts b/packages/core/src/shell/parse.ts
index f86e42e4a3..619e5f867a 100644
--- a/packages/core/src/shell/parse.ts
+++ b/packages/core/src/shell/parse.ts
@@ -158,6 +158,27 @@ const ARITY: Record<string, number> = {
   "yarn run": 3,
 }
 const PREFIX_LENGTH = Math.max(...Object.values(ARITY))
+// Wrappers run the command after their own operands (the value counts them), so a saved prefix has to name that
+// command: `sudo *` would approve every command sudo can run.
+const WRAPPERS: Record<string, number> = {
+  bash: 0,
+  builtin: 0,
+  command: 0,
+  coproc: 0,
+  dash: 0,
+  doas: 0,
+  env: 0,
+  exec: 0,
+  ksh: 0,
+  nice: 0,
+  nohup: 0,
+  sh: 0,
+  sudo: 0,
+  time: 0,
+  timeout: 1,
+  xargs: 0,
+  zsh: 0,
+}
 
 export function scan(command: string, shell: string, cwd: string): Effect.Effect<Result, Error> {
   return Effect.suspend(() => {
@@ -222,9 +243,10 @@ export function scan(command: string, shell: string, cwd: string): Effect.Effect
         output.directories.push(...resolved.directories)
         if (directoryCommand === parts && resolved.complete) continue
       }
-      const selected = prefix(words.slice(0, PREFIX_LENGTH))
-      const conventional = `${selected.join(" ")} *`
-      const end = item.wordEnds?.[selected.length - 1]
+      const selected = powershell ? prefix(words) : bashPrefix(words)
+      // A command that only the shell can identify is saved exactly as approved.
+      const conventional = selected ? `${selected.join(" ")} *` : item.resource
+      const end = selected && item.wordEnds?.[selected.length - 1]
       // Keep existing grants stable unless normalized spacing loses the original source boundary.
       const save =
         !powershell || end === undefined || Wildcard.match(item.resource, conventional)
@@ -600,10 +622,27 @@ function environment(key: string) {
   return name ? process.env[name] : undefined
 }
 
-function prefix(tokens: string[]) {
+function prefix(words: string[]) {
+  const tokens = words.slice(0, PREFIX_LENGTH)
   for (let length = tokens.length; length > 0; length--) {
     const arity = ARITY[tokens.slice(0, length).join(" ")]
     if (arity !== undefined) return tokens.slice(0, arity)
   }
   return tokens.slice(0, 1)
 }
+
+/**
+ * The prefix of a POSIX command that names what it runs, or undefined when that depends on the shell: a dynamic
+ * command name, `eval`, or a wrapper whose options hide where the wrapped command starts.
+ */
+function bashPrefix(words: string[]): string[] | undefined {
+  const head = words[0]
+  if (head === undefined || head === "eval" || !isStaticBashWord(head)) return
+  const operands = WRAPPERS[path.basename(head)]
+  if (operands === undefined) return prefix(words)
+  // Wrappers like env and sudo take assignments before the command; they stay part of the prefix.
+  const command = words.findIndex((word, index) => index > 0 && !/^[A-Za-z_][A-Za-z0-9_]*=/.test(word))
+  if (command === -1 || words[command].startsWith("-")) return
+  const wrapped = bashPrefix(words.slice(command + operands))
+  return wrapped && [...words.slice(0, command + operands), ...wrapped]
+}
