diff --git a/packages/core/test/shell-parse.test.ts b/packages/core/test/shell-parse.test.ts
index 44e882e4ee..5e71f76862 100644
--- a/packages/core/test/shell-parse.test.ts
+++ b/packages/core/test/shell-parse.test.ts
@@ -18,6 +18,33 @@ describe("ShellParse", () => {
     })
   })
 
+  test("saves the wrapped command's prefix, not the wrapper's", async () => {
+    const result = await Effect.runPromise(
+      ShellParse.scan(
+        "sudo rm -rf /var/cache; env FOO=1 npm run dev; timeout 10 git push origin; xargs rm < files; /usr/bin/nohup bun x tsc",
+        "/bin/bash",
+        "/workspace",
+      ),
+    )
+    expect(result.commands.map((command) => command.save)).toEqual([
+      "sudo rm *",
+      "env FOO=1 npm run dev *",
+      "timeout 10 git push *",
+      "xargs rm *",
+      "/usr/bin/nohup bun x tsc *",
+    ])
+  })
+
+  test("saves commands that only the shell can identify exactly", async () => {
+    const commands = ["sh -c 'rm -rf build'", "sudo -u root git status", 'eval "echo hi"', "$(which git) status", "env"]
+    const result = await Effect.runPromise(ShellParse.scan(commands.join("; "), "/bin/bash", "/workspace"))
+    expect(result.commands).toEqual([
+      ...commands.slice(0, 4).map((command) => ({ resource: command, save: command })),
+      { resource: "which git", save: "which *" },
+      { resource: "env", save: "env" },
+    ])
+  })
+
   test("rejects malformed syntax with an explicit scanner error", async () => {
     const malformed = await Effect.runPromiseExit(ShellParse.scan('echo "', "/bin/bash", "/workspace"))
     expect(malformed).toMatchObject({
@@ -150,9 +177,9 @@ describe("ShellParse", () => {
     )
     expect(wrapped).toEqual({
       commands: [
-        { resource: "command cd /outside", save: "command *" },
-        { resource: "builtin cd /elsewhere", save: "builtin *" },
-        { resource: "command -v cd", save: "command *" },
+        { resource: "command cd /outside", save: "command cd *" },
+        { resource: "builtin cd /elsewhere", save: "builtin cd *" },
+        { resource: "command -v cd", save: "command -v cd" },
