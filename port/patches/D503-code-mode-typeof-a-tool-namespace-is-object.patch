From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:19:44 -0700
Subject: [PATCH] D503 code mode: typeof a tool namespace is "object"


diff --git a/packages/codemode/src/codemode/tool-runtime.ts b/packages/codemode/src/codemode/tool-runtime.ts
index f98c92507a..41eb4648f3 100644
--- a/packages/codemode/src/codemode/tool-runtime.ts
+++ b/packages/codemode/src/codemode/tool-runtime.ts
@@ -800,6 +800,12 @@ export const globals = <R>(
   return {
     tools: Host.namespace<R>({
       keys: (path) => namespaceKeys(root, path),
+      // `typeof` is "function" for a tool, including a namespace with a tool of its own, and for a path that names
+      // nothing (which still fails when called); a namespace without one is an object.
+      callable: (path) => {
+        const node = lookup(root, canonicalSegments(path))
+        return node === undefined || node.tool !== undefined
+      },
       resolve: (path) => {
         const segments = canonicalSegments(path)
         if (segments.length === 1 && segments[0] === "search" && lookup(root, segments) === undefined) {
diff --git a/packages/codemode/test/tool-paths.test.ts b/packages/codemode/test/tool-paths.test.ts
index 66b37a721a..b0f14dd15c 100644
--- a/packages/codemode/test/tool-paths.test.ts
+++ b/packages/codemode/test/tool-paths.test.ts
@@ -134,6 +134,14 @@ describe("callable namespaces", () => {
     )
     expect(diagnostic.suggestions).toEqual([`2 more under 'issues'. Use search({ namespace: "issues" }) to list them.`])
   })
+  test("typeof is function for a tool and object for a namespace without one", async () => {
+    const nested = CodeMode.make({ tools: { "issues.list": echo("List issues", "list") } })
+    expect(
+      await value(nested, `const issues = tools.issues; return [typeof tools, typeof issues, typeof issues.list]`),
+    ).toEqual(["object", "object", "function"])
+    expect(await value(runtime, `return typeof tools.issues`)).toBe("function")
+  })
+
 })
 
