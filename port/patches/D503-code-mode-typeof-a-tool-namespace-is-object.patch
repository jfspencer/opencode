 }
+
+/** The `typeof` operator: a namespace only holds tools, so it is an object; a tool, or an unknown path, is a function. */
+export const typeofOperand = <R>(tools: ToolRuntime<R>, value: Value): string =>
+  value instanceof ToolReference && tools.namespace(value.path) ? "object" : typeofValue(value)
