-  ) {
+function enterNodeScope(node: AnyNode, parent: AnyNode | undefined): Set<string> | undefined {
+  if (isFunction(node)) {
     const names = new Set<string>()
     if (node.id) names.add(node.id.name)
     for (const param of node.params) collectPattern(param, names)
-    if (node.body.type === "BlockStatement") {
-      for (const name of collectScope(node.body, true)) names.add(name)
-    }
     return names
   }
-  if (node.type === "BlockStatement") return collectScope(node, false)
+  // A function body's declarations are its own scope: its parameters' defaults cannot see them.
+  if (node.type === "BlockStatement") return collectScope(node, isFunction(parent) && parent.body === node)
   // A class static block is a var scope of its own, like a function body.
   if (node.type === "StaticBlock") return collectScope(node, true)
   if (node.type === "CatchClause") {
@@ -295,6 +300,16 @@ function enterNodeScope(node: AnyNode): Set<string> | undefined {
   return undefined
 }
 
+function isFunction(
+  node: AnyNode | undefined,
+): node is FunctionDeclaration | FunctionExpression | ArrowFunctionExpression {
+  return (
+    node?.type === "FunctionDeclaration" ||
+    node?.type === "FunctionExpression" ||
+    node?.type === "ArrowFunctionExpression"
+  )
+}
+
 function collectScope(container: Program | BlockStatement | StaticBlock, includeVar: boolean): Set<string> {
   const names = new Set<string>()
   for (const statement of container.body) {
diff --git a/packages/codemode/test/scan.test.ts b/packages/codemode/test/scan.test.ts
index 3d4a0d19e2..b9cb3435f4 100644
--- a/packages/codemode/test/scan.test.ts
+++ b/packages/codemode/test/scan.test.ts
@@ -40,6 +40,16 @@ describe("CodeMode.scanTools", () => {
     )
   })
 
+  test("keeps a function body's declarations out of its parameter defaults", () => {
+    expect(CodeMode.scanTools("const f = function (a = tools.danger({})) { var tools }; await f()")).toEqual(
+      Result.succeed(["danger"]),
+    )
+    expect(CodeMode.scanTools("const f = (a = tools.early()) => { let tools; return tools.late() }")).toEqual(
+      Result.succeed(["early"]),
+    )
+    expect(CodeMode.scanTools("const f = function (tools = 1) { return tools.none() }")).toEqual(Result.succeed([]))
+  })
+
   test("rejects empty code, syntax errors, dynamic bracket access, and aliasing tools", () => {
     expect(Result.isFailure(CodeMode.scanTools("   "))).toBe(true)
     expect(Result.isFailure(CodeMode.scanTools("const x = {"))).toBe(true)
