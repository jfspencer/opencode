diff --git a/packages/core/src/util/wildcard.ts b/packages/core/src/util/wildcard.ts
index 65608026f9..8f3193d037 100644
--- a/packages/core/src/util/wildcard.ts
+++ b/packages/core/src/util/wildcard.ts
@@ -4,11 +4,17 @@ export function match(input: string, pattern: string) {
   const normalized = input.replaceAll("\\", "/")
   let escaped = pattern
     .replaceAll("\\", "/")
-    .replace(/[.+^${}()|[\]\\]/g, "\\$&")
-    .replace(/\*/g, ".*")
-    .replace(/\?/g, ".")
+    // `[*]` and `[?]` are a literal `*` and `?` (see `escape`); every other character but `*` and `?` is literal.
+    .replace(/\[([*?])\]|[*?]|[.+^${}()|[\]\\]/g, (token, literal: string | undefined) =>
+      literal ? `\\${literal}` : token === "*" ? ".*" : token === "?" ? "." : `\\${token}`,
+    )
 
   if (escaped.endsWith(" .*")) escaped = escaped.slice(0, -3) + "( .*)?"
 
   return new RegExp("^" + escaped + "$", process.platform === "win32" ? "si" : "s").test(normalized)
 }
+
+/** A pattern that matches `text` itself, for building patterns from commands and paths. */
+export function escape(text: string) {
+  return text.replace(/[*?]/g, "[$&]")
+}
