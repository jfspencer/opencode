diff --git a/packages/server/test/session-create.test.ts b/packages/server/test/session-create.test.ts
index 5d7cbfbacb..aead6a507b 100644
--- a/packages/server/test/session-create.test.ts
+++ b/packages/server/test/session-create.test.ts
@@ -63,3 +63,35 @@ it.live("returns not found when creating a child of a missing session", () =>
     })
   }).pipe(Effect.scoped),
 )
+
+it.live("rejects relative directories instead of failing when they are stored", () =>
+  Effect.gen(function* () {
+    const handler = yield* ServerFetch.make({
+      app: { version: "test" },
+      database: { path: ":memory:" },
+      fs: { filewatcher: false },
+    })
+    const created = yield* Effect.promise(() =>
+      handler(
+        new Request("http://opencode.local/api/session", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ location: { directory: "relative/path" } }),
+        }),
+      ),
+    )
+    expect(created.status).toBe(400)
+    expect(yield* Effect.promise(() => created.json())).toMatchObject({
+      _tag: "InvalidRequestError",
+      field: "location.directory",
+    })
+    const listed = yield* Effect.promise(() =>
+      handler(new Request("http://opencode.local/api/session?directory=relative")),
+    )
+    expect(listed.status).toBe(400)
+    expect(yield* Effect.promise(() => listed.json())).toMatchObject({
+      _tag: "InvalidRequestError",
+      field: "directory",
+    })
+  }).pipe(Effect.scoped),
+)
