From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 14:58:35 -0700
Subject: [PATCH] D121 tools: a CRLF file reads the same whether or not the
 read pages


diff --git a/packages/core/src/tool/read-filesystem.ts b/packages/core/src/tool/read-filesystem.ts
index d644611586..6ce63d5448 100644
--- a/packages/core/src/tool/read-filesystem.ts
+++ b/packages/core/src/tool/read-filesystem.ts
@@ -150,7 +150,10 @@ export const read = Effect.fn("ReadTool.read")(function* (
     // A final separator ends the last physical line; keep it in whole-file content.
     const count = lines.at(-1) === "" ? lines.length - 1 : lines.length
     if (count <= MAX_READ_LINES) {
-      const content = lines.map(clampLine).join("\n")
+      // Lines end without their CR, as in pages.
+      const content = lines
+        .map((line) => clampLine(line.endsWith("\r") ? line.slice(0, -1) : line))
+        .join("\n")
       if (Buffer.byteLength(content) <= MAX_READ_BYTES)
         return { type: "text" as const, content, offset: 1, lineCount: count }
     }
diff --git a/packages/core/test/tool-read-filesystem.test.ts b/packages/core/test/tool-read-filesystem.test.ts
index 90f1dbf5ae..298d18681b 100644
--- a/packages/core/test/tool-read-filesystem.test.ts
+++ b/packages/core/test/tool-read-filesystem.test.ts
@@ -251,7 +251,13 @@ describe("ReadToolFileSystem", () => {
       for (const ending of ["last", "last\n", "last\r\n", "\n"]) {
         const content = prefix + ending
         yield* files.writeFileString(file, content)
-        expect(yield* read()).toEqual({ type: "text", content, offset: 1, lineCount: 2_000 })
+        expect(yield* read()).toEqual({
+          type: "text",
+          // Lines end without their CR, as in pages.
+          content: content.replaceAll("\r\n", "\n"),
+          offset: 1,
+          lineCount: 2_000,
+        })
       }
 
       yield* files.writeFileString(file, prefix + "\r\nlast")
@@ -652,6 +658,23 @@ describe("ReadToolFileSystem", () => {
     }),
   )
 
+  it.effect("drops CRLF carriage returns whether or not it pages", () =>
+    Effect.gen(function* () {
+      const { environment, files, directory } = yield* fixture
+      const file = path.join(directory, "crlf.txt")
+      yield* files.writeFileString(file, "one\r\ntwo\r\n")
+
+      expect(yield* ReadToolFileSystem.read(environment, absolute(file), "crlf.txt")).toMatchObject({
+        type: "text",
+        content: "one\ntwo\n",
+      })
+      expect(yield* ReadToolFileSystem.read(environment, absolute(file), "crlf.txt", { offset: 1 })).toMatchObject({
+        type: "text",
+        content: "one\ntwo",
+      })
+    }),
+  )
+
   it.effect("truncates long lines", () =>
     Effect.gen(function* () {
       const { environment, files, directory } = yield* fixture
