@@ -104,6 +104,27 @@ describe("SessionModelRequest.unsupportedParts", () => {
     expect(unsupportedParts(messages, capabilities(["text", "image"]), "openai")).toEqual(messages)
   })
 
+  test("replaces image types providers cannot decode and files of unknown kind", () => {
+    const messages = unsupportedParts(
+      [
+        Message.user([
+          Message.text("Open these"),
+          { type: "media", media: Media.base64("AAAA", "image/heic"), filename: "a.heic" },
+          { type: "media", media: Media.base64("AAAA", "application/octet-stream") },
+        ]),
+      ],
+      capabilities(["text", "image"]),
+    )
+
+    expect(messages[0]?.content).toEqual([
+      Message.text("Open these"),
+      Message.text('\n\nERROR: Cannot read "a.heic" (this model does not support image/heic input). Inform the user.'),
+      Message.text(
+        "\n\nERROR: Cannot read file (this model does not support application/octet-stream input). Inform the user.",
+      ),
+    ])
+  })
+
   test("preserves supported media", () => {
     const message = Message.user({ type: "media", media: Media.base64("aGVsbG8=", "image/png") })
     expect(unsupportedParts([message], capabilities(["text", "image"]))[0]?.content).toEqual(message.content)
