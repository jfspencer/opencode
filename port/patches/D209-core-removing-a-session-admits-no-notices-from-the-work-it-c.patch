+  it.effect("admits no completion notice from background work the removal cancels", () =>
+    Effect.gen(function* () {
+      const temporary = yield* tmpdirScoped()
+      const sessions = yield* Session.Service
+      const jobs = yield* Job.Service
+      const parent = yield* sessions.create({
+        location: Location.Ref.make({ directory: AbsolutePath.make(temporary.path) }),
+      })
+      const notice = yield* Deferred.make<Exit.Exit<unknown, unknown>>()
+      // Reports the cancellation to the Session the way a background subagent's completion notice does.
+      yield* jobs.start({
+        id: "job_background",
+        type: "test",
+        metadata: { sessionID: parent.id },
+        run: Effect.never.pipe(
+          Effect.onInterrupt(() =>
