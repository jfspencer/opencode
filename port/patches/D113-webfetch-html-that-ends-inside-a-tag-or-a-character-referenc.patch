diff --git a/packages/core/test/tool-webfetch.test.ts b/packages/core/test/tool-webfetch.test.ts
index 6c3458dbfd..73558af9ae 100644
--- a/packages/core/test/tool-webfetch.test.ts
+++ b/packages/core/test/tool-webfetch.test.ts
@@ -185,6 +185,17 @@ describe("WebFetchTool helpers", () => {
     expect(first.length).toBeLessThanOrEqual(html.length)
   })
 
+  test("drops a tag the input ends inside and keeps a reference without digits as text", () => {
+    expect(WebFetchTool.convertHTMLToMarkdown("<p>a</p></div foo")).toBe("a")
+    expect(WebFetchTool.extractTextFromHTML("a</b \u{1f600}")).toBe("a")
+    expect(WebFetchTool.convertHTMLToMarkdown("<p>a</p><div/")).toBe("a")
+    expect(WebFetchTool.convertHTMLToMarkdown("x<s")).toBe("x")
+    expect(WebFetchTool.convertHTMLToMarkdown("x<t")).toBe("x")
+    expect(WebFetchTool.convertHTMLToMarkdown("<ul><li>a<b ")).toBe("- a")
+    expect(WebFetchTool.convertHTMLToMarkdown("<p>a<em ")).toBe("a")
+    expect(WebFetchTool.convertHTMLToMarkdown("<p>hello world &#x")).toBe("hello world &#x")
+  })
+
   test("defaults to the production byte budget with room for closing syntax", () => {
     const output = WebFetchTool.convertHTMLToMarkdown("x".repeat(WebFetchTool.MAX_RESPONSE_BYTES))
     expect(WebFetchTool.MAX_RESPONSE_BYTES).toBe(5 * 1024 * 1024)
