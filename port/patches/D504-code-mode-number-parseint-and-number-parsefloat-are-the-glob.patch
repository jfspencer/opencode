From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:20:16 -0700
Subject: [PATCH] D504 code mode: Number.parseInt and Number.parseFloat are the
 global functions


diff --git a/packages/codemode/test/stdlib.test.ts b/packages/codemode/test/stdlib.test.ts
index d09b4d587a..a59f2abedc 100644
--- a/packages/codemode/test/stdlib.test.ts
+++ b/packages/codemode/test/stdlib.test.ts
@@ -42,3 +42,11 @@ describe("CodeMode values at intra-CodeMode checkpoints", () => {
     expect(observed).toStrictEqual([{ when: "1970-01-01T00:00:00.000Z", tags: {} }])
   })
 })
+
+describe("Number.parseInt and Number.parseFloat", () => {
+  test("are the global functions", async () => {
+    expect(
+      await value(`return [Number.parseInt === parseInt, Number.parseFloat === parseFloat, Number.parseInt("08")]`),
+    ).toEqual([true, true, 8])
+  })
+})
