diff --git a/packages/core/test/tool-execute.test.ts b/packages/core/test/tool-execute.test.ts
index 3a8887227a..6cc88871ca 100644
--- a/packages/core/test/tool-execute.test.ts
+++ b/packages/core/test/tool-execute.test.ts
@@ -10,7 +10,7 @@ import { Agent } from "@opencode/schema/agent"
 import { Session } from "@opencode/schema/session"
 import { SessionMessage } from "@opencode/schema/session-message"
 import type { Info } from "@opencode/schema/tool"
-import { Context, Deferred, Effect, Fiber, Schema } from "effect"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Schema } from "effect"
 import { TestClock } from "effect/testing"
 import { codeModeServices } from "./fixture/codemode"
 import { tmpdir } from "./fixture/tmpdir"
@@ -933,3 +933,66 @@ it.effect("interrupted execute sends its latest progress rows before it settles"
     ])
   }),
 )
+
+test("a declined tool call ends the program uncaught and fails the call with the decline", async () => {
+  const marks: Array<string> = []
+  const mark: Info = {
+    name: "mark",
+    description: "Record a mark",
+    input: Schema.Struct({ at: Schema.String }),
+    output: Schema.String,
+    execute: ({ at }) => Effect.sync(() => (marks.push(at), { output: at })),
+  }
+  const declined: Info = {
+    name: "declined",
+    description: "Fail because the user declined approval",
+    input: Schema.Struct({}),
+    output: Schema.String,
+    execute: () => Effect.die(new Permission.DeclinedError()),
+  }
+  const wrapped: Info = {
+    name: "wrapped",
+    description: "Fail with a decline attached to a tool error",
+    input: Schema.Struct({}),
+    output: Schema.String,
+    execute: () => Effect.fail(new Tool.Error({ message: "Wrapped decline", error: new Permission.DeclinedError() })),
+  }
+  const tools = new Map<string, Info>([
+    ["mark", mark],
+    ["declined", declined],
+    ["wrapped", wrapped],
+  ])
+  for (const name of ["declined", "wrapped"]) {
+    marks.length = 0
+    const exit = await Effect.runPromise(
+      Effect.exit(
+        createCodeMode(tools).execute(
+          {
+            code: `try { await tools.${name}({}) } catch (e) { await tools.mark({ at: "catch" }) } finally { await tools.mark({ at: "finally" }) }
+return await tools.mark({ at: "after" })`,
+          },
+          context,
+        ),
+      ),
+    )
+    expect(Exit.isFailure(exit)).toBe(true)
+    if (!Exit.isFailure(exit)) continue
+    expect(exit.cause.reasons).toHaveLength(1)
+    const reason = exit.cause.reasons[0]!
+    expect(Cause.isDieReason(reason)).toBe(true)
+    if (!Cause.isDieReason(reason)) continue
+    expect(reason.defect).toBeInstanceOf(Permission.DeclinedError)
+    expect(marks).toEqual([])
+  }
+  marks.length = 0
+  const settled = await Effect.runPromise(
+    Effect.exit(
+      createCodeMode(tools).execute(
+        { code: `const settled = await Promise.allSettled([tools.declined({})])\nawait tools.mark({ at: settled[0].status })` },
+        context,
+      ),
+    ),
+  )
+  expect(Exit.isFailure(settled)).toBe(true)
+  expect(marks).toEqual([])
+})
