From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Mon, 9 Nov 2026 04:33:36 -0700
Subject: [PATCH] D517 code mode: declining a call inside a program ends the
 turn

Upstream: Permission.assert tunnels a plain "reject" as a defect so that no tool can catch it, and a direct call's
decline ends the turn as a user interrupt (D213). Inside Code Mode the runtime turns every cause of a host call
that is not an interrupt into an error the program catches: a declined tool call reaches the program as
`Permission.DeclinedError`, a declined `fetch` as an `Error` with an empty message, and the program goes on to
make further calls the user never saw, then the turn continues ("codemode fetch rejected with feedback" recorded
`"Error: "` and the model's next turn).
Fixed: the bridge records the decline and ends the host call as an interrupt, which both interpreters propagate
uncaught (no `catch`, `finally` or rejection handler runs, and `Promise.allSettled` does not observe it); the
execute call then fails with the decline however the program ended, so the turn ends as a direct call's decline
does (the call fails with "The user declined this tool call", outcome "interrupted"). A rejection with feedback
stays an error the program catches. Covers tool calls (the decline as a defect, or attached to a failure as
SessionModelRequest finds it) and `fetch`.
Scenarios: codemode-tools.test.ts "codemode fetch rejected with feedback", "codemode tool call rejected" (new),
both engines
Upstream tests: packages/core/test/tool-execute.test.ts adds tests (both engines)

diff --git a/packages/core/src/codemode/decline.ts b/packages/core/src/codemode/decline.ts
new file mode 100644
index 0000000000..3b883b3680
--- /dev/null
+++ b/packages/core/src/codemode/decline.ts
@@ -0,0 +1,60 @@
+export * as CodeModeDecline from "./decline.js"
+
+import { Cause, Context, Effect, Option, Ref } from "effect"
+import { Permission } from "../permission.js"
+import { QuestionTool } from "../tool/plugin/question.js"
+
+export type Decline = Permission.DeclinedError | QuestionTool.CancelledError
+
+/** Where a program's host calls record a decline they met; one per `execute` call. */
+export class Service extends Context.Service<Service, Ref.Ref<Decline | undefined>>()("@opencode/CodeModeDecline") {}
+
+const isDecline = (value: unknown): value is Decline =>
+  value instanceof Permission.DeclinedError || value instanceof QuestionTool.CancelledError
+
+/** The decline in a cause: a defect, a failure, or a failure's attached `error` (as SessionModelRequest finds it). */
+const find = (cause: Cause.Cause<unknown>) =>
+  cause.reasons
+    .flatMap((reason) =>
+      Cause.isDieReason(reason)
+        ? [reason.defect]
+        : Cause.isFailReason(reason)
+          ? [
+              reason.error,
+              typeof reason.error === "object" && reason.error !== null
+                ? (reason.error as { error?: unknown }).error
+                : undefined,
+            ]
+          : [],
+    )
+    .find(isDecline)
+
+/**
+ * A user's plain "no" arrives as a defect so that no tool can catch it (see Permission.assert), but a program would
+ * catch the error its runtime makes of one. Record the decline instead and end the host call as an interrupt, which
+ * neither engine lets the program catch (no `catch` or `finally` runs), so the program ends there.
+ */
+export const stop = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+  effect.pipe(
+    Effect.catchCause((cause) =>
+      Effect.gen(function* () {
+        const decline = find(cause)
+        const declined = yield* Effect.serviceOption(Service)
+        if (decline === undefined || Option.isNone(declined)) return yield* Effect.failCause(cause)
+        yield* Ref.set(declined.value, decline)
+        return yield* Effect.interrupt
+      }),
+    ),
+  )
+
+/**
+ * Fails a program's `execute` call with the decline one of its calls met, however the program ended, so the turn
+ * stops as it does for a direct call's decline.
+ */
+export const resume = <A, E, R>(declined: Ref.Ref<Decline | undefined>, effect: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const exit = yield* Effect.exit(effect)
+    const decline = yield* Ref.get(declined)
+    if (decline !== undefined) return yield* Effect.die(decline)
+    return yield* exit
+  })
