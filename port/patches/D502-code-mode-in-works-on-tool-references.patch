From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sat, 7 Nov 2026 13:57:45 -0700
Subject: [PATCH] D502 code mode: `in` works on tool references

Upstream: `"models" in tools.opencode` threw "TypeError: Binary operators require data values.", although Object.keys and for...in enumerate tool references and interpreter-support.md lists `in` across the supported values.
Fixed: `key in reference` is true when Object.keys(reference) lists the key (false under a tool; an unknown namespace is the same UnknownTool error as Object.keys). Both engines.
Scenarios: codemode-tools.test.ts "codemode tool references and failures" (in)
Upstream tests: test/enumeration.test.ts adds "`in` finds the names Object.keys lists"

diff --git a/packages/codemode/src/interpreter/interpreter.ts b/packages/codemode/src/interpreter/interpreter.ts
index fdbf5433a2..aaf2ed2bc4 100644
--- a/packages/codemode/src/interpreter/interpreter.ts
+++ b/packages/codemode/src/interpreter/interpreter.ts
@@ -1675,8 +1675,13 @@ class Frame<R> {
     // references, which are not Obj) compare by identity.
     const equality = operator === "==" || operator === "!="
     // `in` checks the right operand before ToPropertyKey on the left, so a bad right side wins over a bad key.
-    if (operator === "in" && lhs instanceof Obj && !isOpaque(lhs) && rhs instanceof Obj) {
-      return has(rhs, yield* this.toPropertyKey(lhs, node))
+    if (
+      operator === "in" &&
+      lhs instanceof Obj &&
+      !isOpaque(lhs) &&
+      (rhs instanceof Obj || rhs instanceof ToolReference)
+    ) {
+      return this.hasKey(rhs, yield* this.toPropertyKey(lhs, node))
     }
     const other = lhs instanceof Obj ? rhs : lhs
     const converts =
@@ -1694,7 +1699,9 @@ class Frame<R> {
     if (operator === "!==") return lhs !== rhs
     if (operator === "==") return this.looselyEqual(lhs, rhs, node)
     if (operator === "!=") return !this.looselyEqual(lhs, rhs, node)
-    if (operator === "in" && rhs instanceof Obj && !isOpaque(lhs)) return has(rhs, propertyKey(lhs))
+    if (operator === "in" && (rhs instanceof Obj || rhs instanceof ToolReference) && !isOpaque(lhs)) {
+      return this.hasKey(rhs, propertyKey(lhs))
+    }
     if (isOpaque(lhs) || isOpaque(rhs)) {
       throw invalidData("Binary operators require data values.", node)
     }
@@ -1742,6 +1749,12 @@ class Frame<R> {
     }
   }
 
+  // A tool reference has the names Object.keys lists for it.
+  private hasKey(target: Obj | ToolReference, key: PropertyKey): boolean {
+    if (target instanceof Obj) return has(target, key)
+    return typeof key !== "symbol" && this.ctx.tools.keys(target.path).includes(String(key))
+  }
+
   // IsLooselyEqual: objects (including functions and tool references) compare by identity, and a nullish
   // primitive never equals an object.
   private looselyEqual(lhs: Value, rhs: Value, node: AstNode): boolean {
