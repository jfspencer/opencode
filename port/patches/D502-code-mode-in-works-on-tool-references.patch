From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:19:29 -0700
Subject: [PATCH] D502 code mode: `in` works on tool references


diff --git a/packages/codemode/test/enumeration.test.ts b/packages/codemode/test/enumeration.test.ts
index 197e5688d9..13731f45f6 100644
--- a/packages/codemode/test/enumeration.test.ts
+++ b/packages/codemode/test/enumeration.test.ts
@@ -62,6 +62,18 @@ describe("Object.keys over tool references", () => {
     expect(failure.message).toContain("Unknown tool namespace 'nonexistent'")
   })
 
+  test("`in` finds the names Object.keys lists", async () => {
+    expect(
+      await value(`
+      const key = { toString() { return "memory" } }
+      return ["list_issues" in tools.github, "nope" in tools.github, "github" in tools, "value" in tools.memory.search, key in tools]
+    `),
+    ).toEqual([true, false, true, false, true])
+    const failure = await error(`return "list_issues" in tools.nonexistent`)
+    expect(failure.kind).toBe("UnknownTool")
+    expect(failure.message).toContain("Unknown tool namespace 'nonexistent'")
+  })
+
   test("Object.values/entries on a tool reference explain the working idioms", async () => {
     for (const method of ["values", "entries"] as const) {
       const failure = await error(`return Object.${method}(tools)`)
diff --git a/patches/psychoscript@0.2.1.patch b/patches/psychoscript@0.2.1.patch
index 8fd285ab52..c65dcba766 100644
--- a/patches/psychoscript@0.2.1.patch
+++ b/patches/psychoscript@0.2.1.patch
@@ -265,6 +265,15 @@ diff --git a/dist/runtime/objects.js b/dist/runtime/objects.js
 diff --git a/dist/runtime/operations.js b/dist/runtime/operations.js
 --- a/dist/runtime/operations.js
 +++ b/dist/runtime/operations.js
+@@ -162,7 +162,7 @@
+  */
+ export const operatorConversion = (operator, lhs, rhs) => {
+     // `in` checks the right operand before ToPropertyKey on the left, so a bad right side wins over a bad key.
+-    if (operator === "in" && lhs instanceof Obj && !isOpaque(lhs) && rhs instanceof Obj)
++    if (operator === "in" && lhs instanceof Obj && !isOpaque(lhs) && (rhs instanceof Obj || rhs instanceof HostNamespace))
+         return { kind: "key" };
+     // IsLooselyEqual converts only an object facing a non-nullish primitive; two objects (including namespace
+     // references, which are not Obj) compare by identity.
 @@ -243,7 +243,7 @@
          if (typeof key !== "string") {
              throw typeError(`${objectValue.root} paths must use string property names.`, propertyNode);
@@ -563,7 +572,7 @@ diff --git a/dist/vm.js b/dist/vm.js
          requirePromiseProperty(writableReference(ref, memberNode), memberNode);
      }
      execBinarySlow(frame, op, a, b, pc, sp) {
-+        if (op === "in" && b instanceof HostNamespace) {
++        if (op === "in" && b instanceof HostNamespace && !(a instanceof Obj)) {
 +            frame.regs[sp - 1] = this.ctx.namespaceKeys(b).includes(propertyKey(a));
 +            return false;
 +        }
