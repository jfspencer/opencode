From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:21:24 -0700
Subject: [PATCH] D511 code mode: JSON.parse converts its text with the
 object's own toString


diff --git a/packages/codemode/test/stdlib.test.ts b/packages/codemode/test/stdlib.test.ts
index 2d10c2aca8..0df220ac83 100644
--- a/packages/codemode/test/stdlib.test.ts
+++ b/packages/codemode/test/stdlib.test.ts
@@ -87,3 +87,14 @@ describe("Object.prototype.toString of generators", () => {
     ).toEqual(["[object AsyncGenerator]", "[object Generator]", "[object AsyncGenerator]"])
   })
 })
+
+describe("JSON.parse text", () => {
+  test("converts its text through the object's own toString", async () => {
+    expect(
+      await value(`
+        const text = { valueOf() { return "1" }, toString() { return "[7]" } }
+        return [JSON.parse(text), JSON.parse([3]), JSON.parse(5)]
+      `),
+    ).toEqual([[7], 3, 5])
+  })
+})
