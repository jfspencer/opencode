diff --git a/packages/server/src/handlers/shell.ts b/packages/server/src/handlers/shell.ts
index 2954ddcd0e..c01c18083b 100644
--- a/packages/server/src/handlers/shell.ts
+++ b/packages/server/src/handlers/shell.ts
@@ -1,9 +1,10 @@
 import { Shell } from "@opencode/core/shell"
 import { Environment } from "@opencode/core/environment/index"
 import { Location } from "@opencode/core/location"
-import { Effect } from "effect"
+import { AppProcess } from "@opencode/util/process"
+import { Effect, PlatformError } from "effect"
 import { HttpApiBuilder, HttpApiSchema } from "effect/http-api"
-import { InvalidRequestError, ShellNotFoundError } from "@opencode/protocol/errors"
+import { InvalidRequestError, ShellNotFoundError, UnknownError } from "@opencode/protocol/errors"
 import { Api } from "../api"
 import { response } from "../location"
 
@@ -33,7 +34,11 @@ export const ShellHandler = HttpApiBuilder.group(Api, "server.shell", (handlers)
               kind: "invalid_cwd",
               field: "cwd",
             })
-          return yield* response(shell.create({ ...ctx.payload, cwd }).pipe(Effect.orDie))
+          return yield* response(
+            shell
+              .create({ ...ctx.payload, cwd })
+              .pipe(Effect.catchTag("AppProcessError", (error) => startFailure(error, cwd))),
+          )
         }),
       )
       .handle(
@@ -80,3 +85,29 @@ export const ShellHandler = HttpApiBuilder.group(Api, "server.shell", (handlers)
       )
   }),
 )
+
+/** The system rejects some commands before they start; those are the caller's to fix, anything else is host state. */
+const startFailure = Effect.fnUntraced(function* (error: AppProcess.AppProcessError, cwd: string) {
+  const reason = PlatformError.isPlatformError(error.cause) ? error.cause.reason : undefined
+  if (reason?._tag === "BadArgument")
+    return yield* new InvalidRequestError({
+      message: "The command contains a NUL character",
+      kind: "invalid_command",
+      field: "command",
+    })
+  if (reason?._tag === "PermissionDenied")
+    return yield* new InvalidRequestError({
+      message: `cwd is not accessible: ${cwd}`,
+      kind: "invalid_cwd",
+      field: "cwd",
+    })
+  if ((reason?.cause as NodeJS.ErrnoException | undefined)?.code === "E2BIG")
+    return yield* new InvalidRequestError({
+      message: "The command is too long to run",
+      kind: "invalid_command",
+      field: "command",
+    })
+  const ref = `err_${crypto.randomUUID().slice(0, 8)}`
+  yield* Effect.logError("failed to start shell command", { cause: error }).pipe(Effect.annotateLogs({ ref }))
+  return yield* new UnknownError({ message: "Unexpected server error. Check server logs for details.", ref })
+})
diff --git a/packages/server/test/shell.test.ts b/packages/server/test/shell.test.ts
index 4dfc0d575e..58bf0f7978 100644
--- a/packages/server/test/shell.test.ts
+++ b/packages/server/test/shell.test.ts
@@ -1,3 +1,4 @@
+import fs from "node:fs/promises"
 import path from "node:path"
 import { expect } from "bun:test"
 import { Effect } from "effect"
@@ -68,3 +69,50 @@ it.live("reads an empty page when the limit is zero", () =>
     })
   }).pipe(Effect.scoped),
 )
+
+it.live("rejects commands the system cannot start", () =>
+  Effect.gen(function* () {
+    const tmp = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-shell-endpoint-")))
+    const handler = yield* ServerFetch.make({
+      app: { version: "test" },
+      database: { path: ":memory:" },
+      config: { directory: tmp.path },
+      fs: { filewatcher: false },
+      models: { fetch: false },
+    })
+    const create = (body: unknown) =>
+      Effect.promise(async () => {
+        const response = await handler(
+          new Request(`http://opencode.local/api/shell?location[directory]=${encodeURIComponent(tmp.path)}`, {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify(body),
+          }),
+        )
+        return { status: response.status, body: await response.json() }
+      })
+    expect(yield* create({ command: "echo a\0b" })).toMatchObject({
+      status: 400,
+      body: { _tag: "InvalidRequestError", kind: "invalid_command", field: "command" },
+    })
+    if (process.platform === "win32") return
+    expect(yield* create({ command: `echo ${"x".repeat(4 * 1024 * 1024)}` })).toMatchObject({
+      status: 400,
+      body: { _tag: "InvalidRequestError", kind: "invalid_command", field: "command" },
+    })
+    if (process.getuid?.() === 0) return
+    const locked = path.join(tmp.path, "locked")
+    yield* Effect.promise(() => fs.mkdir(locked, { mode: 0o000 }))
+    const denied = yield* create({ command: "true", cwd: locked })
+    yield* Effect.promise(() => fs.chmod(locked, 0o755))
+    expect(denied).toMatchObject({
+      status: 400,
+      body: {
+        _tag: "InvalidRequestError",
+        kind: "invalid_cwd",
+        field: "cwd",
+        message: `cwd is not accessible: ${locked}`,
+      },
+    })
+  }).pipe(Effect.scoped),
+)
