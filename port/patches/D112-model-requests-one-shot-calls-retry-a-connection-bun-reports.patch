index 9ec5dbd1d4..efe3ebb391 100644
--- a/packages/core/src/model-retry.ts
+++ b/packages/core/src/model-retry.ts
@@ -105,7 +105,8 @@ export const retry = <A, R>(effect: Effect.Effect<A, AIError, R>) =>
 // the provider never ran, a few times, with the same backoff and retry-after handling.
 const ONE_SHOT_RETRIES = 3
 // Only codes that fail before a connection exists: a dropped interface or route can also fail a response already being read.
-const NOT_SENT_CODES = new Set(["ECONNREFUSED", "ENOTFOUND", "EAI_AGAIN"])
+// Bun's fetch reports a refused connection as ConnectionRefused, Node's as ECONNREFUSED.
+const NOT_SENT_CODES = new Set(["ECONNREFUSED", "ConnectionRefused", "ENOTFOUND", "EAI_AGAIN"])
 
 const notRun = (error: AIError) => {
   const override = error.reason.http?.headers["x-should-retry"]
