+test("clears a failed step's retry once its continuation starts", async () => {
+  const listeners = new Set<Parameters<CreateDataInput["event"]["listen"]>[0]>()
+  const error = { type: "provider.transport" as const, message: "Disconnected" }
+  const model = { providerID: "provider", id: "model" }
+  const api = OpenCode.make({
+    baseUrl: "http://opencode.local",
+    fetch: async () =>
+      Response.json({
+        data: [
+          {
+            id: "msg_failed",
+            type: "assistant",
+            agent: "build",
+            model,
+            time: { created: 1, completed: 2 },
+            content: [{ type: "text", text: "Partial" }],
+            finish: "error",
+            error,
+          },
+        ],
+        cursor: {},
+      }),
+  })
+  const setup = createRoot((dispose) => ({
+    data: createData({
+      api: () => api,
+      directory: "/project",
+      event: {
+        on: () => () => {},
+        listen(handler) {
+          listeners.add(handler)
+          return () => listeners.delete(handler)
+        },
+      },
+      connection: { status: () => "connected" },
+    }),
+    dispose,
+  }))
+  const emit = (event: OpenCodeEvent) => listeners.forEach((listener) => listener({ name: event.type, details: event }))
+  try {
+    await setup.data.session.message.sync("ses_retry")
+    // A step that failed after output is completed before its retry is scheduled; the retry continues in a new step.
+    emit({
+      id: "evt_retry",
+      created: 3,
+      type: "session.retry.scheduled",
+      durable: { aggregateID: "ses_retry", seq: 1, version: 1 },
+      data: { sessionID: "ses_retry", assistantMessageID: "msg_failed", attempt: 2, at: 4, error },
+    })
+    await wait(() => setup.data.session.message.get("ses_retry", "msg_failed")?.type === "assistant")
+    expect(setup.data.session.message.get("ses_retry", "msg_failed")).toMatchObject({ retry: { attempt: 2 } })
+    emit({
+      id: "evt_continued",
+      created: 5,
+      type: "session.step.started",
+      durable: { aggregateID: "ses_retry", seq: 2, version: 1 },
+      data: { sessionID: "ses_retry", assistantMessageID: "msg_continued", agent: "build", model, started: 5 },
+    })
+    await wait(() => setup.data.session.message.get("ses_retry", "msg_continued") !== undefined)
+    expect(setup.data.session.message.get("ses_retry", "msg_failed")).toMatchObject({
+      error,
+      retry: undefined,
+      time: { created: 1, completed: 2 },
+    })
+  } finally {
+    setup.dispose()
+  }
+})
+
