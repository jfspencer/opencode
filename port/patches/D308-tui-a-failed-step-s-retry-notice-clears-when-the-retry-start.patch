diff --git a/packages/core/test/session-projector.test.ts b/packages/core/test/session-projector.test.ts
index a818c954f5..54d327893e 100644
--- a/packages/core/test/session-projector.test.ts
+++ b/packages/core/test/session-projector.test.ts
@@ -595,6 +595,50 @@ describe("SessionProjector", () => {
     }),
   )
 
+  it.effect("clears a failed step's retry once its continuation starts", () =>
+    Effect.gen(function* () {
+      const db = yield* seedSession()
+      const bus = yield* Bus.Service
+      const failed = SessionMessage.ID.make("msg_retry_failed")
+      const error = { type: "provider.transport" as const, message: "Disconnected" }
+      yield* bus.publish(SessionEvent.Step.Started, {
+        sessionID,
+        assistantMessageID: failed,
+        agent: build,
+        model,
+        started: 0,
+      })
+      // A step that failed after output is completed before its retry is scheduled; the retry continues in a new step.
+      yield* bus.publish(SessionEvent.Step.Failed, { sessionID, assistantMessageID: failed, error })
+      yield* bus.publish(SessionEvent.RetryScheduled, {
+        sessionID,
+        assistantMessageID: failed,
+        attempt: 2,
+        at: 2_000,
+        error,
+      })
+
+      const decode = (row: typeof SessionMessageTable.$inferSelect | undefined) =>
+        Schema.decodeUnknownSync(SessionMessage.Info)({ ...row?.data, id: row?.id, type: row?.type })
+      const row = () =>
+        db.select().from(SessionMessageTable).where(eq(SessionMessageTable.id, failed)).get().pipe(Effect.orDie)
+      const scheduled = decode(yield* row())
+      expect(scheduled).toMatchObject({ error, retry: { attempt: 2 } })
+
+      yield* bus.publish(SessionEvent.Step.Started, {
+        sessionID,
+        assistantMessageID: SessionMessage.ID.make("msg_retry_continued"),
+        agent: build,
+        model,
+        started: 3_000,
+      })
+
+      const continued = decode(yield* row())
+      expect(continued).not.toHaveProperty("retry")
+      expect(continued).toMatchObject({ error, time: scheduled.time })
+    }),
+  )
+
