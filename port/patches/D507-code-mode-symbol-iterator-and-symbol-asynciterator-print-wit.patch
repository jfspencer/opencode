Subject: [PATCH] D507 code mode: Symbol.iterator and Symbol.asyncIterator
 print with their JS names


diff --git a/packages/codemode/test/stdlib.test.ts b/packages/codemode/test/stdlib.test.ts
index a59f2abedc..01030049ce 100644
--- a/packages/codemode/test/stdlib.test.ts
+++ b/packages/codemode/test/stdlib.test.ts
@@ -50,3 +50,12 @@ describe("Number.parseInt and Number.parseFloat", () => {
     ).toEqual([true, true, 8])
   })
 })
+
+describe("well-known symbols", () => {
+  test("print with their JS names", async () => {
+    expect(await value(`return [String(Symbol.iterator), String(Symbol.asyncIterator)]`)).toEqual([
+      "Symbol(Symbol.iterator)",
+      "Symbol(Symbol.asyncIterator)",
+    ])
+  })
+})
