diff --git a/packages/server/test/project-update.test.ts b/packages/server/test/project-update.test.ts
new file mode 100644
index 0000000000..b2bc3256d7
--- /dev/null
+++ b/packages/server/test/project-update.test.ts
@@ -0,0 +1,31 @@
+import { expect } from "bun:test"
+import { Effect } from "effect"
+import { it } from "../../core/test/lib/effect"
+import { ServerFetch } from "../src/fetch"
+
+it.live("rejects a relative canonical directory instead of failing when it is stored", () =>
+  Effect.gen(function* () {
+    const handler = yield* ServerFetch.make({
+      app: { version: "test" },
+      database: { path: ":memory:" },
+      fs: { filewatcher: false },
+    })
+    const update = (projectID: string, body: unknown) =>
+      Effect.promise(async () => {
+        const response = await handler(
+          new Request(`http://opencode.local/api/project/${projectID}`, {
+            method: "PATCH",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify(body),
+          }),
+        )
+        return { status: response.status, body: await response.json() }
+      })
+    const relative = yield* update("global", { canonical: "relative/path" })
+    expect(relative.status).toBe(400)
+    expect(relative.body).toMatchObject({ _tag: "InvalidRequestError", field: "canonical" })
+    const unknown = yield* update("does-not-exist", { canonical: "/absolute" })
+    expect(unknown.status).toBe(404)
+    expect(unknown.body).toMatchObject({ _tag: "ProjectNotFoundError" })
+  }).pipe(Effect.scoped),
+)
