@@ -1158,6 +1158,14 @@ describe("String.raw", () => {
     ).toEqual(["x1y", "x!yz", ""])
   })
 
+  test("a primitive raw is read as an object: a string's characters are its literals", async () => {
+    expect(
+      await value(
+        `return [String.raw({ raw: "abc" }, 1, 2), String.raw({ raw: "ab" }, "-", "+"), String.raw({ raw: 5 }, 1)]`,
