From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:21:32 -0700
Subject: [PATCH] D512 code mode: String.raw accepts a string raw


diff --git a/packages/codemode/test/stdlib.test.ts b/packages/codemode/test/stdlib.test.ts
index 0df220ac83..42c93d6d49 100644
--- a/packages/codemode/test/stdlib.test.ts
+++ b/packages/codemode/test/stdlib.test.ts
@@ -98,3 +98,11 @@ describe("JSON.parse text", () => {
     ).toEqual([[7], 3, 5])
   })
 })
+
+describe("String.raw", () => {
+  test("a primitive raw is read as an object: a string's characters are its literals", async () => {
+    expect(
+      await value(`return [String.raw({ raw: "abc" }, 1, 2), String.raw({ raw: "ab" }, "-", "+"), String.raw({ raw: 5 }, 1)]`),
+    ).toEqual(["a1b2c", "a-b", ""])
+  })
+})
