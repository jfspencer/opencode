diff --git a/packages/server/test/agent-get.test.ts b/packages/server/test/agent-get.test.ts
new file mode 100644
index 0000000000..3a729a3388
--- /dev/null
+++ b/packages/server/test/agent-get.test.ts
@@ -0,0 +1,32 @@
+import fs from "node:fs/promises"
+import path from "node:path"
+import { expect } from "bun:test"
+import { Effect } from "effect"
+import { tmpdir } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { startServer } from "./fixture/server"
+
+it.live("waits for plugin initialization before getting an agent", () =>
+  Effect.gen(function* () {
+    const tmp = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-agent-endpoint-")))
+    yield* Effect.promise(() =>
+      fs.writeFile(
+        path.join(tmp.path, "opencode.json"),
+        JSON.stringify({ agents: { build: { description: "Configured build" } } }),
+      ),
+    )
+    const server = yield* startServer(tmp.path)
+    const get = (route: string) =>
+      Effect.promise(async () => {
+        const url = new URL(route, server.base)
+        url.searchParams.set("location[directory]", tmp.path)
+        const response = await fetch(url, { headers: server.headers })
+        return { status: response.status, body: await response.json() }
+      })
+
+    // The first request to the location: the configured description is applied by a config plugin.
+    const build = yield* get("/api/agent/build")
+    expect(build.status).toBe(200)
+    expect(build.body).toMatchObject({ data: { id: "build", description: "Configured build" } })
+  }),
+)
