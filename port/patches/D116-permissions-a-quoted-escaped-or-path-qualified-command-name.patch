@@ -90,12 +90,21 @@ const compatibilityCases: Array<[string, string, Record<string, string>, ShellPa
       {},
       { commands: [], directories: ["$HOME", path.join(os.homedir(), "outside")] },
     ],
-    ["bash", 'g""it status', {}, { commands: [{ resource: 'g""it status', save: 'g""it *' }], directories: [] }],
+    // Quoted names are looked up as the command they name.
+    ["bash", 'g""it status', {}, { commands: [{ resource: 'g""it status', save: 'g""it status *' }], directories: [] }],
+    ["bash", "'sudo' ls", {}, { commands: [{ resource: "'sudo' ls", save: "'sudo' ls *" }], directories: [] }],
+    ["bash", "\\sudo ls", {}, { commands: [{ resource: "\\sudo ls", save: "\\sudo ls *" }], directories: [] }],
+    [
+      "bash",
+      "/usr/bin/git status",
+      {},
+      { commands: [{ resource: "/usr/bin/git status", save: "/usr/bin/git status *" }], directories: [] },
+    ],
     [
       "bash",
       'npm "run" test',
       {},
-      { commands: [{ resource: 'npm "run" test', save: 'npm "run" *' }], directories: [] },
+      { commands: [{ resource: 'npm "run" test', save: 'npm "run" test *' }], directories: [] },
     ],
     ["bash", "git '*'", {}, { commands: [{ resource: "git '*'", save: "git '[*]' *" }], directories: [] }],
     [
