+  test("saves a command after assignments or redirects exactly", async () => {
+    const commands = ["FOO=1 git status", "2>err git status", ">> log.txt echo appended"]
+    const result = await Effect.runPromise(ShellParse.scan(commands.join("; "), "/bin/bash", "/workspace"))
+    expect(result.commands).toEqual(commands.map((command) => ({ resource: command, save: command })))
