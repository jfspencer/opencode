index 032655c271..387510a7b4 100644
--- a/packages/tui/src/app.tsx
+++ b/packages/tui/src/app.tsx
@@ -700,17 +700,17 @@ function App() {
       })
       .then((response) => {
         const match = response.data[0]?.id
-        if (!match) return
-        if (!args.fork) {
-          route.navigate({ type: "session", sessionID: match, prompt: startupPrompt })
-          return
-        }
-        void client.api.session
+        // The placeholder session route waits for this: leave it for home when there is nothing to continue.
+        if (!match) return route.navigate({ type: "home" })
+        if (!args.fork) return route.navigate({ type: "session", sessionID: match, prompt: startupPrompt })
+        return client.api.session
           .fork({ sessionID: match })
           .then((result) => route.navigate({ type: "session", sessionID: result.id, prompt: startupPrompt }))
-          .catch(toast.error)
       })
-      .catch(toast.error)
+      .catch((error) => {
+        toast.error(error)
+        route.navigate({ type: "home" })
+      })
   })
 
   // Handle --session with --fork once.
@@ -1444,7 +1444,15 @@ function App() {
                   <Home />
                 </Match>
                 <Match when={route.data.type === "session"}>
-                  <Show when={route.data.type === "session" ? route.data.sessionID : undefined} keyed>
+                  {/* --continue starts on a "dummy" placeholder until the latest session is known. */}
+                  <Show
+                    when={
+                      route.data.type === "session" && route.data.sessionID !== "dummy"
+                        ? route.data.sessionID
+                        : undefined
+                    }
+                    keyed
+                  >
                     {(sessionID) => (
                       <SessionFrame
                         sessionID={sessionID}
