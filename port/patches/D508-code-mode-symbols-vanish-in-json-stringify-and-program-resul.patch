Subject: [PATCH] D508 code mode: symbols vanish in JSON.stringify and program
 results


diff --git a/packages/codemode/test/codemode.test.ts b/packages/codemode/test/codemode.test.ts
index 1ca48b0d9e..98ac975525 100644
--- a/packages/codemode/test/codemode.test.ts
+++ b/packages/codemode/test/codemode.test.ts
@@ -1401,6 +1401,23 @@ describe("CodeMode public contract", () => {
     expect(Schema.decodeUnknownSync(CodeMode.Result)(JSON.parse(JSON.stringify(result)))).toStrictEqual(result)
   })
 
+  test("symbols vanish like undefined, in results and in JSON.stringify", async () => {
+    const result = await Effect.runPromise(
+      CodeMode.execute({
+        code: `return {
+          sym: Symbol.iterator,
+          list: [Symbol.asyncIterator],
+          text: [JSON.stringify(Symbol.iterator), JSON.stringify({ a: Symbol.iterator, b: 1 }), JSON.stringify([Symbol.iterator])],
+        }`,
+      }),
+    )
+    expect(result).toStrictEqual({
+      ok: true,
+      value: { list: [null], text: [null, '{"b":1}', "[null]"] },
+      toolCalls: [],
+    })
+  })
+
   test("returns the final top-level expression when return is omitted", async () => {
     const result = await Effect.runPromise(CodeMode.execute({ code: `1; 2` }))
 
