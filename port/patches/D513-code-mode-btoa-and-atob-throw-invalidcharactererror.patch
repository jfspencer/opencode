From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode-port <port@localhost>
Date: Sun, 22 Nov 2026 15:21:39 -0700
Subject: [PATCH] D513 code mode: btoa and atob throw InvalidCharacterError


diff --git a/packages/codemode/test/stdlib.test.ts b/packages/codemode/test/stdlib.test.ts
index 42c93d6d49..74b8f91603 100644
--- a/packages/codemode/test/stdlib.test.ts
+++ b/packages/codemode/test/stdlib.test.ts
@@ -106,3 +106,26 @@ describe("String.raw", () => {
     ).toEqual(["a1b2c", "a-b", ""])
   })
 })
+
+describe("btoa and atob errors", () => {
+  test("invalid input throws an Error named InvalidCharacterError, the DOMException JS throws", async () => {
+    expect(
+      await value(`
+        const caught = (f) => { try { f() } catch (e) { return [e.name, e.message, e instanceof Error, e instanceof TypeError, String(e)] } }
+        return [caught(() => btoa("€")), caught(() => atob("!"))]
+      `),
+    ).toEqual(
+      Array(2).fill([
+        "InvalidCharacterError",
+        "The string contains invalid characters.",
+        true,
+        false,
+        "InvalidCharacterError: The string contains invalid characters.",
+      ]),
+    )
+    const result = await run(`atob("!")`)
+    expect(result.ok ? undefined : result.error.message).toBe(
+      "InvalidCharacterError: The string contains invalid characters. (line 1, col 1)",
+    )
+  })
+})
