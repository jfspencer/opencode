index 4d9e63145a..151c1b9224 100644
--- a/packages/codemode/src/interpreter/model.ts
+++ b/packages/codemode/src/interpreter/model.ts
@@ -41,6 +41,8 @@ export const OptionalShortCircuit: unique symbol = Symbol("codemode.optional-sho
 export class PendingThrow {
   node?: AstNode
   value?: ErrorObj
+  /** The name a DOMException has (`InvalidCharacterError`): code mode has no DOMException, so it is an `Error`. */
+  name?: string
 
   constructor(
     /** The JS error class a program sees when it catches this failure. */
@@ -58,6 +60,13 @@ const failure = (type: ErrorType, kind?: DiagnosticKind) => (message: string, no
   new PendingThrow(type, message, node, kind)
 
 export const typeError = failure("TypeError")
+
+/** A DOMException such as `InvalidCharacterError`: an `Error` with that name, since code mode has no DOMException. */
+export const domException = (name: string, message: string, node?: AstNode): PendingThrow => {
+  const failure = new PendingThrow("Error", message, node)
+  failure.name = name
+  return failure
+}
 export const invalidData = failure("TypeError", "InvalidDataValue")
 export const rangeError = failure("RangeError")
 export const referenceError = failure("ReferenceError")
