+// A path that does not exist, or that runs through a file (ENOTDIR, reported as BadResource), names nothing.
+const missing =
+  <E>(error: () => E) =>
+  <A, R>(self: Effect.Effect<A, PlatformError.PlatformError, R>) =>
+    self.pipe(
+      Effect.catchReasons(
+        "PlatformError",
+        { NotFound: () => Effect.fail(error()), BadResource: () => Effect.fail(error()) },
+        (_, cause) => Effect.die(cause),
+      ),
+    )
+
 export const node = makeLocationNode({
   service: Service,
   layer: baseLayer,
