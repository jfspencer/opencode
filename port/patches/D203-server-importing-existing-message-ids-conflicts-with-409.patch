diff --git a/packages/server/test/session-import.test.ts b/packages/server/test/session-import.test.ts
index 32291488a5..fe94590123 100644
--- a/packages/server/test/session-import.test.ts
+++ b/packages/server/test/session-import.test.ts
@@ -150,3 +150,19 @@ it.live("rejects an invalid imported message without creating the session", () =
     }).pipe(Effect.scoped),
   )
 })
+
+it.live("rejects message IDs that already exist without creating the imported session", () =>
+  Effect.gen(function* () {
+    const request = yield* setup
+    const template = Schema.decodeUnknownSync(SessionResponse)(yield* request("/api/session", {}))
+    const messages = [{ id: "msg_imported", type: "user", text: "Hello", time: { created: 1 } }]
+    yield* request("/api/experimental/session/import", {
+      info: { ...template.data, id: Session.ID.create() },
+      messages,
+    })
+    const id = Session.ID.create()
+    const error = yield* request("/api/experimental/session/import", { info: { ...template.data, id }, messages }, 409)
+    expect(error).toMatchObject({ _tag: "ConflictError", resource: "msg_imported" })
+    expect(yield* request(`/api/session/${id}`, undefined, 404)).toMatchObject({ _tag: "SessionNotFoundError" })
+  }).pipe(Effect.scoped),
+)
