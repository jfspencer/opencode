diff --git a/packages/server/test/command.test.ts b/packages/server/test/command.test.ts
new file mode 100644
index 0000000000..519a0b3040
--- /dev/null
+++ b/packages/server/test/command.test.ts
@@ -0,0 +1,29 @@
+import fs from "node:fs/promises"
+import path from "node:path"
+import { expect } from "bun:test"
+import { Effect } from "effect"
+import { tmpdir } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { startServer } from "./fixture/server"
+
+it.live("waits for plugin initialization before listing commands", () =>
+  Effect.gen(function* () {
+    const tmp = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-command-endpoint-")))
+    yield* Effect.promise(() =>
+      fs.writeFile(path.join(tmp.path, "opencode.json"), JSON.stringify({ commands: { demo: { template: "Demo" } } })),
+    )
+    const server = yield* startServer(tmp.path)
+    const url = new URL("/api/command", server.base)
+    url.searchParams.set("location[directory]", tmp.path)
+    const response = yield* Effect.promise(() => fetch(url, { headers: server.headers }))
+
+    expect(response.status).toBe(200)
+    const body: unknown = yield* Effect.promise(() => response.json())
+    if (!isRecord(body) || !Array.isArray(body["data"])) throw new Error("Expected a command list response")
+    expect(body["data"].some((command) => isRecord(command) && command["name"] === "demo")).toBeTrue()
+  }),
+)
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+}
